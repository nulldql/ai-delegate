  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "openai": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.7.3"
  }
}
